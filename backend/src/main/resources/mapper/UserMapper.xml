<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.backend.trma.mapper.UserMapper">

    <!-- ========================= -->
    <!-- 아이디 중복 확인 -->
    <!-- ========================= -->
    <select id="existsUserId"
            parameterType="string"
            resultType="int">

        SELECT
            COUNT(1)
        FROM tb_trma_user_info a
        WHERE
            a.USER_ID = #{userId}

    </select>

    <!-- ========================= -->
    <!-- 회원가입_사용자정보 -->
    <!-- ========================= -->
    <insert id="insertUser"
            parameterType="com.example.backend.trma.dto.request.SignupRequest">

        INSERT INTO tb_trma_user_info
        (
        USER_ID
        ,USER_PW
        ,USER_NM
        ,STATE_CD
        ,ROLE_CD
        ,BIRTH_DT
        ,GENDER_CD
        ,PHONE_NUM
        ,CREATE_USER
        ,CREATE_DT
        ,UPDATE_USER
        ,UPDATE_DT
        )VALUES(
        #{userId}
        ,#{userPw}
        ,#{userNm}
        ,#{stateCd}
        ,#{roleCd}
        ,#{birthDt}
        ,#{genderCd}
        ,#{phoneNum}
        ,#{userId}
        ,CURRENT_TIMESTAMP
        ,#{userId}
        ,CURRENT_TIMESTAMP
        )

    </insert>

    <!-- ========================= -->
    <!-- 로그인 -->
    <!-- ========================= -->
    <select id="login"
            parameterType="com.example.backend.trma.dto.request.LoginRequest"
            resultType="String">

        SELECT
            a.USER_PW
        FROM tb_trma_user_info a
        WHERE
        a.USER_ID = #{userId}

    </select>

    <!-- ========================= -->
    <!-- 로그인 이력 등록 -->
    <!-- ========================= -->
    <insert id="insertUserHist"
            parameterType="com.example.backend.trma.dto.request.LoginRequest">

        INSERT INTO tb_trma_login_hist
        (
        USER_ID
        ,LOGIN_TOKEN
        ,LOGIN_DT
        )VALUES(
        #{userId}
        ,#{loginToken}
        ,CURRENT_TIMESTAMP
        )

    </insert>

</mapper>